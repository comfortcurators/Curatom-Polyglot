# Local development only. Do not copy these values into production.

# Shared HMAC key for the local Worker/orchestrator seam.
# This value is intentionally a labelled test key. Generate a separate
# 32+ byte random production secret and store it with the deployment platform.
CURATOM_HMAC_KEY=dGVzdC1obWFjLWtleS1jaGFuZ2UtbWUtaW4tcHJvZC0xMjM0NTY=

# Local kernel identity/environment.
CURATOM_OWNER_ID=org_comfortcurators_owner
CURATOM_ENV=development

# Elixir outcome callback target when running the orchestrator locally.
CURATOM_WORKER_URL=http://127.0.0.1:8787
PORT=4000

# Production-only credentials such as RAJ_TOKEN, TURNSTILE_SECRET and
# ZEPTO_TOKEN are deliberately absent. Set them through the platform secret
# store, not this file.
