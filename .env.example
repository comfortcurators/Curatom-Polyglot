# Shared HMAC key for Contract 2 (Worker ↔ Elixir) and Contract 3.
# 32+ random bytes, standard-base64. Both sides decode base64; if decode
# fails they use the raw UTF-8 bytes so a plaintext secret still works.
CURATOM_HMAC_KEY=dGVzdC1obWFjLWtleS1jaGFuZ2UtbWUtaW4tcHJvZC0xMjM0NTY=

# Kernel
CURATOM_OWNER_ID=org_comfortcurators_owner
CURATOM_ENV=development

# Worker public URL (Elixir reports outcomes here)
CURATOM_WORKER_URL=http://127.0.0.1:8787

# Elixir orchestrator (Worker hands jobs here)
CURATOM_ORCHESTRATOR_URL=http://127.0.0.1:4000/v1/jobs
PORT=4000

# Expo (dev identity header; production is Cloudflare Access)
EXPO_PUBLIC_CURATOM_API=http://127.0.0.1:8787
EXPO_PUBLIC_DEV_ORGANIC_ID=org_comfortcurators_owner
