{
 "openapi": "3.1.0",
 "info": {
  "title": "Curatom key API",
  "version": "2026-11-15",
  "description": "Endpoints an AI agent can use with a Curatom key. Full guide: https://curatom.rajvansh.dev/llm-guide.md . Send the key as header x-curatom-token. Flag problems honestly to the operator."
 },
 "servers": [
  {
   "url": "https://curatom.rajvansh.dev"
  }
 ],
 "security": [
  {
   "curatomHeader": []
  },
  {
   "curatomQuery": []
  }
 ],
 "components": {
  "securitySchemes": {
   "curatomHeader": {
    "type": "apiKey",
    "in": "header",
    "name": "x-curatom-token",
    "description": "Preferred."
   },
   "curatomQuery": {
    "type": "apiKey",
    "in": "query",
    "name": "token",
    "description": "Legacy; ends up in logs."
   }
  },
  "schemas": {
   "Error": {
    "type": "object",
    "properties": {
     "error": {
      "type": "string"
     }
    },
    "required": [
     "error"
    ]
   },
   "Submit": {
    "type": "object",
    "required": [
     "name",
     "reason",
     "resources",
     "permissions"
    ],
    "properties": {
     "token": {
      "type": "string",
      "description": "Optional if sent in the x-curatom-token header."
     },
     "name": {
      "type": "string",
      "description": "How the operator will see you. Use a recognisable, honest name."
     },
     "reason": {
      "type": "string",
      "description": "One plain sentence."
     },
     "resources": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "description": "e.g. company.whitepaper; see /inorganic/handoff"
     },
     "permissions": {
      "type": "array",
      "items": {
       "type": "string",
       "enum": [
        "read",
        "write"
       ]
      }
     },
     "duration": {
      "type": "object",
      "properties": {
       "kind": {
        "type": "string",
        "enum": [
         "single_use",
         "ttl"
        ]
       },
       "seconds": {
        "type": "integer",
        "minimum": 1
       }
      }
     }
    }
   },
   "Handoff": {
    "type": "object",
    "properties": {
     "token": {
      "type": "string",
      "description": "Optional if sent in the header."
     }
    }
   }
  }
 },
